<?xml version="1.0" encoding="UTF-8"?>
<interface domain="steady">
  <requires lib="gtk" version="4.12"/>
  <requires lib="Adw" version="1.5"/>
  <template class="SteadyWindow" parent="AdwApplicationWindow">
    <property name="title">Steady</property>
    <property name="default-width">1080</property>
    <property name="default-height">760</property>
    <property name="width-request">360</property>
    <property name="height-request">480</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwNavigationSplitView" id="split">
            <property name="min-sidebar-width">300</property>
            <property name="max-sidebar-width">380</property>
            <property name="sidebar-width-fraction">0.34</property>
            <property name="sidebar">
              <object class="AdwNavigationPage">
                <property name="title" translatable="yes">Tasks</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="title-widget"><object class="AdwWindowTitle"><property name="title">Steady</property><property name="subtitle" translatable="yes">See every task through</property></object></property>
                        <child type="start"><object class="GtkMenuButton" id="menu_button"><property name="icon-name">open-menu-symbolic</property><property name="tooltip-text" translatable="yes">Main menu</property></object></child>
                        <child type="end"><object class="GtkButton" id="new_button"><property name="icon-name">list-add-symbolic</property><property name="tooltip-text" translatable="yes">New task (Ctrl+N)</property><property name="action-name">win.new-task</property><style><class name="suggested-action"/></style></object></child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child><object class="GtkBox"><property name="spacing">8</property><property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">8</property><property name="margin-bottom">8</property>
                          <child><object class="GtkSearchEntry" id="search"><property name="placeholder-text" translatable="yes">Search tasks and progress</property><property name="hexpand">true</property><property name="width-chars">8</property><property name="valign">center</property></object></child>
                          <child><object class="GtkDropDown" id="task_filter"><property name="halign">end</property><property name="valign">center</property><property name="tooltip-text" translatable="yes">Filter by task status together with search keywords</property><accessibility><property name="label" translatable="yes">Task status filter</property></accessibility></object></child>
                        </object></child>
                        <child>
                          <object class="GtkStack" id="list_stack">
                            <property name="vexpand">true</property>
                            <child><object class="GtkStackPage"><property name="name">tasks</property><property name="child">
                              <object class="GtkScrolledWindow" id="list_scroll"><property name="hscrollbar-policy">never</property><property name="child">
                                <object class="GtkBox"><property name="orientation">vertical</property>
                                  <child><object class="GtkListBox" id="task_list"><property name="selection-mode">single</property><style><class name="navigation-sidebar"/></style></object></child>
                                  <child><object class="GtkButton" id="more_tasks"><property name="label" translatable="yes">Load More Tasks</property><property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-bottom">12</property><style><class name="flat"/></style></object></child>
                                </object>
                              </property></object>
                            </property></object></child>
                            <child><object class="GtkStackPage"><property name="name">empty</property><property name="child"><object class="AdwStatusPage" id="list_empty"><property name="icon-name">object-select-symbolic</property><property name="title" translatable="yes">No open tasks</property><property name="description" translatable="yes">Create a task and take the first step.</property><style><class name="compact"/></style></object></property></object></child>
                          </object>
                        </child>
                        <child><object class="GtkLabel"><property name="label" translatable="yes">Saved locally · Works offline</property><property name="margin-top">10</property><property name="margin-bottom">10</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
            <property name="content">
              <object class="AdwNavigationPage" id="detail_page">
                <property name="title" translatable="yes">Task Details</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="title-widget"><object class="GtkLabel"><property name="label" translatable="yes">Task Details</property><style><class name="heading"/></style></object></property>
                        <child type="end"><object class="GtkMenuButton" id="edit_button"><property name="icon-name">view-more-symbolic</property><property name="tooltip-text" translatable="yes">Task actions: edit or delete</property></object></child>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkStack" id="detail_stack">
                        <child><object class="GtkStackPage"><property name="name">empty</property><property name="child"><object class="AdwStatusPage"><property name="icon-name">view-list-symbolic</property><property name="title" translatable="yes">Every step, recorded</property><property name="description" translatable="yes">Select a task to view its progress, or create your first task.</property><property name="child"><object class="GtkButton"><property name="label" translatable="yes">New Task</property><property name="halign">center</property><property name="action-name">win.new-task</property><style><class name="suggested-action"/><class name="pill"/></style></object></property></object></property></object></child>
                        <child><object class="GtkStackPage"><property name="name">task</property><property name="child">
                          <object class="GtkScrolledWindow" id="detail_scroll"><property name="hscrollbar-policy">never</property><property name="child">
                            <object class="AdwClamp"><property name="maximum-size">780</property><property name="tightening-threshold">560</property><property name="child">
                              <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">14</property><property name="margin-start">24</property><property name="margin-end">24</property><property name="margin-top">22</property><property name="margin-bottom">24</property>
                                <child><object class="GtkBox"><property name="spacing">12</property>
                                  <child><object class="GtkLabel" id="task_status"><property name="xalign">0</property><property name="hexpand">true</property><property name="valign">center</property><style><class name="caption-heading"/></style></object></child>
                                  <child><object class="GtkButton" id="status_button"><property name="label" translatable="yes">Close Task</property><property name="valign">center</property><property name="action-name">win.change-status</property></object></child>
                                </object></child>
                                <child><object class="GtkLabel" id="task_title"><property name="xalign">0</property><property name="wrap">true</property><property name="wrap-mode">word-char</property><property name="selectable">true</property><style><class name="title-1"/></style></object></child>
                                <child><object class="GtkLabel" id="task_description"><property name="xalign">0</property><property name="wrap">true</property><property name="wrap-mode">word-char</property><property name="selectable">true</property></object></child>
                                <child><object class="GtkLabel" id="task_deadline"><property name="xalign">0</property><property name="wrap">true</property><property name="selectable">true</property></object></child>
                                <child><object class="GtkLabel" id="task_meta"><property name="xalign">0</property><property name="wrap">true</property><property name="selectable">true</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
                                <child><object class="GtkSeparator"><property name="margin-top">8</property><property name="margin-bottom">8</property></object></child>
                                <child><object class="GtkExpander" id="todo_expander"><property name="label" translatable="yes">Todo List · Optional</property><property name="child">
                                  <object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">10</property><property name="margin-top">12</property>
                                    <child><object class="GtkListBox" id="todo_list"><property name="selection-mode">none</property><style><class name="boxed-list"/></style></object></child>
                                    <child><object class="GtkButton" id="more_todos"><property name="label" translatable="yes">Load More Todo Items</property><style><class name="flat"/></style></object></child>
                                    <child><object class="GtkLabel" id="todo_empty"><property name="label" translatable="yes">Break tasks into small steps. Using a checklist is entirely optional.</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
                                    <child><object class="GtkBox" id="todo_input_box"><property name="spacing">8</property>
                                      <child><object class="GtkEntry" id="todo_input"><property name="hexpand">true</property><property name="max-length">500</property><property name="placeholder-text" translatable="yes">Add an actionable step…</property><accessibility><property name="label" translatable="yes">New Todo text, Enter to add</property></accessibility></object></child>
                                      <child><object class="GtkButton"><property name="icon-name">list-add-symbolic</property><property name="tooltip-text" translatable="yes">Add Todo</property><property name="action-name">win.add-todo</property><style><class name="suggested-action"/></style></object></child>
                                    </object></child>
                                  </object>
                                </property></object></child>
                                <child><object class="GtkSeparator"><property name="margin-top">8</property><property name="margin-bottom">8</property></object></child>
                                <child><object class="GtkBox"><property name="spacing">8</property>
                                  <child><object class="GtkLabel" id="history_heading"><property name="label" translatable="yes">Activity</property><property name="xalign">0</property><property name="hexpand">true</property><property name="wrap">true</property><style><class name="heading"/></style></object></child>
                                  <child><object class="GtkDropDown" id="history_filter"><property name="tooltip-text" translatable="yes">Filter by activity type</property><accessibility><property name="label" translatable="yes">Activity type filter</property></accessibility></object></child>
                                </object></child>
                                <child><object class="GtkListBox" id="history_list"><property name="selection-mode">none</property><style><class name="boxed-list"/></style></object></child>
                                <child><object class="GtkLabel" id="history_empty"><property name="label" translatable="yes">No activity matches this filter</property><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
                                <child><object class="GtkButton" id="more_events"><property name="label" translatable="yes">Load Earlier Activity</property><style><class name="flat"/></style></object></child>
                              </object>
                            </property></object>
                          </property></object>
                        </property></object></child>
                      </object>
                    </property>
                    <child type="bottom">
                      <object class="GtkBox" id="bottom_box"><property name="orientation">vertical</property>
                        <child><object class="GtkSeparator"/></child>
                        <child><object class="AdwClamp"><property name="maximum-size">780</property><property name="child">
                          <object class="GtkBox" id="composer"><property name="orientation">vertical</property><property name="spacing">10</property><property name="margin-start">24</property><property name="margin-end">24</property><property name="margin-top">16</property><property name="margin-bottom">16</property>
                            <child><object class="GtkLabel"><property name="label" translatable="yes">Progress Added</property><property name="xalign">0</property><style><class name="heading"/></style></object></child>
                            <child><object class="GtkFrame"><property name="child"><object class="GtkScrolledWindow"><property name="min-content-height">82</property><property name="max-content-height">130</property><property name="propagate-natural-height">true</property><property name="hscrollbar-policy">never</property><property name="child"><object class="GtkTextView" id="progress_input"><property name="wrap-mode">word-char</property><property name="top-margin">10</property><property name="bottom-margin">10</property><property name="left-margin">12</property><property name="right-margin">12</property><accessibility><property name="label" translatable="yes">Progress note, Ctrl+Enter to save</property></accessibility></object></property></object></property></object></child>
                            <child><object class="GtkBox"><property name="spacing">8</property>
                              <child><object class="GtkLabel" id="draft_hint"><property name="label" translatable="yes">Ctrl+Enter to save progress</property><property name="xalign">0</property><property name="hexpand">true</property><property name="wrap">true</property><style><class name="dim-label"/><class name="caption"/></style></object></child>
                              <child><object class="GtkButton" id="save_progress"><property name="label" translatable="yes">Add Progress</property><property name="action-name">win.save-progress</property><style><class name="suggested-action"/></style></object></child>
                            </object></child>
                          </object>
                        </property></object></child>
                        <child><object class="GtkLabel" id="closed_hint"><property name="label" translatable="yes">This task is closed. Reopen it to add more progress.</property><property name="wrap">true</property><property name="margin-top">18</property><property name="margin-bottom">18</property><property name="margin-start">24</property><property name="margin-end">24</property><style><class name="dim-label"/></style></object></child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
