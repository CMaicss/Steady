#: steady/__main__.py:18
#, python-brace-format
msgid "{app_name} — Local tasks and progress"
msgstr "{app_name} — Lokale Aufgaben und Fortschritte"

#: steady/__main__.py:20
msgid "Use a separate data directory (defaults to XDG_DATA_HOME)"
msgstr "Separates Datenverzeichnis verwenden (standardmäßig XDG_DATA_HOME)"

#: steady/__main__.py:21
msgid "Interface language for this launch only; auto follows the system"
msgstr "Oberflächensprache nur für diesen Start; auto folgt dem System"

#: steady/__main__.py:26
#, python-brace-format
msgid ""
"Could not load GTK/libadwaita: {error}\n"
"On Ubuntu/Debian, install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 and run with /usr/bin/python3."
msgstr ""
"GTK/libadwaita konnte nicht geladen werden: {error}\n"
"Unter Ubuntu/Debian python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 installieren und mit /usr/bin/python3 starten."

#: steady/application.py:54
#, python-brace-format
msgid "{app_name} requires GTK ≥ 4.12 and libadwaita ≥ 1.5. Install newer system libraries or use Flatpak."
msgstr "{app_name} benötigt GTK ≥ 4.12 und libadwaita ≥ 1.5. Neuere Systembibliotheken installieren oder Flatpak verwenden."

#: steady/application.py:57
msgid "Legacy task data found. Close the old application, then run python3 tools/install.py from the source directory to migrate. Existing data will not be overwritten and no empty database will be created."
msgstr "Aufgabendaten einer älteren Version gefunden. Die alte Anwendung schließen und python3 tools/install.py im Quellverzeichnis zur Migration ausführen. Vorhandene Daten werden nicht überschrieben und es wird keine leere Datenbank erstellt."

#: steady/application.py:64
msgid "Could not open task data"
msgstr "Aufgabendaten konnten nicht geöffnet werden"

#: steady/application.py:64
#, python-brace-format
msgid ""
"{error}\n"
"\n"
"Data location: {data_dir}\n"
"\n"
"Existing data will not be erased. Check directory permissions and disk space, or start with a separate data directory and restore a backup."
msgstr ""
"{error}\n"
"\n"
"Datenverzeichnis: {data_dir}\n"
"\n"
"Vorhandene Daten werden nicht gelöscht. Zugriffsrechte und freien Speicher prüfen oder mit einem separaten Datenverzeichnis starten und eine Sicherung wiederherstellen."

