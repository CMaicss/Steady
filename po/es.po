#: steady/__main__.py:18
#, python-brace-format
msgid "{app_name} — Local tasks and progress"
msgstr "{app_name} — Tareas y avances locales"

#: steady/__main__.py:20
msgid "Use a separate data directory (defaults to XDG_DATA_HOME)"
msgstr "Usar un directorio de datos separado (XDG_DATA_HOME de forma predeterminada)"

#: steady/__main__.py:21
msgid "Interface language for this launch only; auto follows the system"
msgstr "Idioma solo para este inicio; auto sigue el sistema"

#: steady/__main__.py:26
#, python-brace-format
msgid ""
"Could not load GTK/libadwaita: {error}\n"
"On Ubuntu/Debian, install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 and run with /usr/bin/python3."
msgstr ""
"No se pudo cargar GTK/libadwaita: {error}\n"
"En Ubuntu/Debian, instale python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 y ejecute con /usr/bin/python3."

#: steady/application.py:54
#, python-brace-format
msgid "{app_name} requires GTK ≥ 4.12 and libadwaita ≥ 1.5. Install newer system libraries or use Flatpak."
msgstr "{app_name} requiere GTK ≥ 4.12 y libadwaita ≥ 1.5. Instale bibliotecas más recientes o use Flatpak."

#: steady/application.py:57
msgid "Legacy task data found. Close the old application, then run python3 tools/install.py from the source directory to migrate. Existing data will not be overwritten and no empty database will be created."
msgstr "Se encontraron datos de una versión anterior. Cierre la aplicación antigua y ejecute python3 tools/install.py desde el directorio del código fuente para migrarlos. No se sobrescribirán los datos ni se creará una base vacía."

#: steady/application.py:64
msgid "Could not open task data"
msgstr "No se pudieron abrir los datos"

#: steady/application.py:64
#, python-brace-format
msgid ""
"{error}\n"
"\n"
"Data location: {data_dir}\n"
"\n"
"Existing data will not be erased. Check directory permissions and disk space, or start with a separate data directory and restore a backup."
msgstr ""
"{error}\n"
"\n"
"Ubicación de los datos: {data_dir}\n"
"\n"
"No se borrarán los datos existentes. Revise los permisos y el espacio en disco, o inicie con un directorio separado y restaure una copia."

