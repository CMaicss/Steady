#: steady/__main__.py:18
#, python-brace-format
msgid "{app_name} — Local tasks and progress"
msgstr "{app_name} — Tâches et progression en local"

#: steady/__main__.py:20
msgid "Use a separate data directory (defaults to XDG_DATA_HOME)"
msgstr "Utiliser un dossier de données séparé (XDG_DATA_HOME par défaut)"

#: steady/__main__.py:21
msgid "Interface language for this launch only; auto follows the system"
msgstr "Langue pour ce lancement uniquement ; auto suit le système"

#: steady/__main__.py:26
#, python-brace-format
msgid ""
"Could not load GTK/libadwaita: {error}\n"
"On Ubuntu/Debian, install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 and run with /usr/bin/python3."
msgstr ""
"Impossible de charger GTK/libadwaita : {error}\n"
"Sous Ubuntu/Debian, installez python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 et lancez avec /usr/bin/python3."

#: steady/application.py:54
#, python-brace-format
msgid "{app_name} requires GTK ≥ 4.12 and libadwaita ≥ 1.5. Install newer system libraries or use Flatpak."
msgstr "{app_name} nécessite GTK ≥ 4.12 et libadwaita ≥ 1.5. Installez des bibliothèques plus récentes ou utilisez Flatpak."

#: steady/application.py:57
msgid "Legacy task data found. Close the old application, then run python3 tools/install.py from the source directory to migrate. Existing data will not be overwritten and no empty database will be created."
msgstr "Des données d'une ancienne version ont été trouvées. Fermez l'ancienne application, puis exécutez python3 tools/install.py depuis le dossier source pour les migrer. Les données existantes ne seront pas écrasées et aucune base vide ne sera créée."

#: steady/application.py:64
msgid "Could not open task data"
msgstr "Impossible d'ouvrir les données"

#: steady/application.py:64
#, python-brace-format
msgid ""
"{error}\n"
"\n"
"Data location: {data_dir}\n"
"\n"
"Existing data will not be erased. Check directory permissions and disk space, or start with a separate data directory and restore a backup."
msgstr ""
"{error}\n"
"\n"
"Emplacement des données : {data_dir}\n"
"\n"
"Les données existantes ne seront pas effacées. Vérifiez les permissions et l'espace disque, ou démarrez avec un dossier séparé et restaurez une sauvegarde."

