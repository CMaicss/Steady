#: steady/window.py:762
#, python-brace-format
msgid ""
"Backup contents — Tasks: {tasks_count}; activity records: {events_count}; Todo items: {todos_count}.\n"
"\n"
"Existing data will be saved to the backups folder in the data directory before restoring. This replaces data; it does not merge it."
msgstr ""
"Contenu — Tâches : {tasks_count} ; activités : {events_count} ; Todos : {todos_count}.\n"
"\n"
"Les données actuelles seront sauvegardées dans le sous-dossier backups du dossier de données avant restauration. Elles seront remplacées, et non fusionnées."

#: steady/window.py:762
msgid "Restore Backup"
msgstr "Restaurer la sauvegarde"

#: steady/window.py:765
msgid "Restore failed"
msgstr "Échec de la restauration"

#: steady/window.py:767
msgid "Could not read backup"
msgstr "Impossible de lire la sauvegarde"

#: steady/window.py:779
msgid "Backup restored; previous data was backed up automatically"
msgstr "Sauvegarde restaurée ; les anciennes données ont été sauvegardées automatiquement"

#: steady/window.py:786
msgid ""
"Ctrl+N  New task\n"
"Ctrl+F  Search tasks and progress\n"
"Ctrl+Enter  Add progress\n"
"Ctrl+Q  Quit and save drafts\n"
"\n"
"Use the arrow keys to navigate the task list.\n"
"Deadlines can be added, changed or removed at any time."
msgstr ""
"Ctrl+N  Nouvelle tâche\n"
"Ctrl+F  Rechercher les tâches et progressions\n"
"Ctrl+Entrée  Ajouter une progression\n"
"Ctrl+Q  Quitter et enregistrer les brouillons\n"
"\n"
"Les flèches permettent de parcourir la liste.\n"
"Les échéances peuvent être ajoutées, modifiées ou supprimées à tout moment."

#: steady/window.py:793
msgid ""
"Simple, offline task and progress management.\n"
"Every step recorded, every task brought to a close."
msgstr ""
"Gestion simple et hors ligne des tâches et de leur progression.\n"
"Chaque étape enregistrée, chaque tâche menée à son terme."

#: steady/window.py:802
msgid "Language saved. Quit normally and reopen Steady to apply it; your drafts will be kept."
msgstr "Langue enregistrée. Quittez normalement puis rouvrez Steady ; vos brouillons seront conservés."

#: steady/window.py:816
msgid "Quit anyway?"
msgstr "Quitter quand même ?"

#: steady/window.py:816
msgid "Some drafts could not be written to disk. Cancel and submit your progress, or quit and discard unsaved drafts."
msgstr "Certains brouillons n'ont pas pu être enregistrés. Annulez pour envoyer votre progression, ou quittez en abandonnant les brouillons non enregistrés."

#: steady/window.py:816
msgid "Quit Anyway"
msgstr "Quitter quand même"

