#: steady/window.py:517
#, python-brace-format
msgid ""
"{kind} · {created_at}\n"
"\n"
"Only this record will be deleted; the current task or Todo state will not be reverted. This cannot be undone. You can export a backup first."
msgstr ""
"{kind} · {created_at}\n"
"\n"
"Seul cet enregistrement sera supprimé ; l'état de la tâche et du Todo ne sera pas rétabli. Cette action est irréversible. Vous pouvez d'abord exporter une sauvegarde."

#: steady/window.py:517
msgid "Delete Activity"
msgstr "Supprimer l'activité"

