msgstr "Не удалось прочитать настройку языка; используется системный язык: {error}"

#: steady/storage.py:23
#, python-brace-format
msgid "{label} must be valid text"
msgstr "Поле «{label}» должно содержать допустимый текст"

#: steady/storage.py:26
#, python-brace-format
msgid "Required field: {label}"
msgstr "Обязательное поле: {label}"

