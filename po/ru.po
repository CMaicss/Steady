msgid "{label} cannot exceed {maximum:,} characters"
msgstr "Поле «{label}» не может содержать более {maximum:,} символов"

#: steady/storage.py:38
msgid "Invalid deadline"
msgstr "Недопустимый срок"

#: steady/storage.py:66
#, python-brace-format
msgid "This database was created by a newer version. Open it with a newer {app_name}"
msgstr "База создана более новой версией. Откройте её в более новой версии {app_name}"

#: steady/storage.py:69
#, python-brace-format
msgid "This file is not a {app_name} database. Opening was stopped to protect your data"
msgstr "Этот файл не является базой {app_name}. Открытие остановлено для защиты данных"

#: steady/storage.py:102
msgid "Database integrity check failed. Restore a backup; the original file has not been overwritten"
msgstr "Проверка целостности базы не пройдена. Восстановите копию; исходный файл не перезаписан"

#: steady/storage.py:164
msgid "Task not found; a different backup may have been restored"
msgstr "Задача не найдена; возможно, была восстановлена другая резервная копия"

#: steady/storage.py:170
msgid "This task is closed. Reopen it first"
