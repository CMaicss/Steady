#: steady/__main__.py:18
#, python-brace-format
msgid "{app_name} — Local tasks and progress"
msgstr "{app_name} — Локальные задачи и ход работы"

#: steady/__main__.py:20
msgid "Use a separate data directory (defaults to XDG_DATA_HOME)"
msgstr "Использовать отдельный каталог данных (по умолчанию XDG_DATA_HOME)"

#: steady/__main__.py:21
msgid "Interface language for this launch only; auto follows the system"
msgstr "Язык интерфейса только для этого запуска; auto — системный язык"

#: steady/__main__.py:26
#, python-brace-format
msgid ""
"Could not load GTK/libadwaita: {error}\n"
"On Ubuntu/Debian, install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 and run with /usr/bin/python3."
msgstr ""
"Не удалось загрузить GTK/libadwaita: {error}\n"
"В Ubuntu/Debian установите python3-gi gir1.2-gtk-4.0 gir1.2-adw-1 и запустите через /usr/bin/python3."

#: steady/application.py:54
#, python-brace-format
msgid "{app_name} requires GTK ≥ 4.12 and libadwaita ≥ 1.5. Install newer system libraries or use Flatpak."
msgstr "Для {app_name} нужны GTK ≥ 4.12 и libadwaita ≥ 1.5. Обновите системные библиотеки или используйте Flatpak."

#: steady/application.py:57
msgid "Legacy task data found. Close the old application, then run python3 tools/install.py from the source directory to migrate. Existing data will not be overwritten and no empty database will be created."
msgstr "Найдены данные старой версии. Закройте старое приложение и выполните python3 tools/install.py из каталога исходного кода для переноса. Существующие данные не будут перезаписаны, пустая база не будет создана."

#: steady/application.py:64
msgid "Could not open task data"
msgstr "Не удалось открыть данные задач"

#: steady/application.py:64
#, python-brace-format
msgid ""
"{error}\n"
"\n"
"Data location: {data_dir}\n"
"\n"
"Existing data will not be erased. Check directory permissions and disk space, or start with a separate data directory and restore a backup."
msgstr ""
"{error}\n"
"\n"
"Каталог данных: {data_dir}\n"
"\n"
"Существующие данные не будут удалены. Проверьте права доступа и место на диске либо запустите приложение с отдельным каталогом и восстановите резервную копию."

#: steady/dialogs.py:15 steady/widgets.py:34
msgid "Cancel"
msgstr "Отмена"

#: steady/dialogs.py:36
msgid "Discard unsaved changes?"
msgstr "Отменить несохранённые изменения?"

#: steady/dialogs.py:36
msgid "Your changes will not be saved if you close this dialog."
msgstr "При закрытии этого окна изменения не сохранятся."

#: steady/dialogs.py:36
msgid "Discard Changes"
msgstr "Отменить изменения"

#: steady/dialogs.py:49
msgid "Language"
msgstr "Язык / Language"

#: steady/dialogs.py:49 steady/dialogs.py:76 steady/dialogs.py:183
msgid "Save"
msgstr "Сохранить"

#: steady/dialogs.py:53
msgid "The language will change on the next launch. Task content is not translated, and unsubmitted drafts are kept."
msgstr "Язык изменится при следующем запуске. Содержимое задач не переводится, неотправленные черновики сохраняются."

#: steady/dialogs.py:54
msgid "Interface Language"
msgstr "Язык интерфейса"

#: steady/dialogs.py:54
msgid "System Default"
msgstr "Системный язык"

#: steady/dialogs.py:76
msgid "Edit Task"
msgstr "Изменить задачу"

#: steady/dialogs.py:76 steady/window.ui:71
msgid "New Task"
msgstr "Новая задача"

#: steady/dialogs.py:76 steady/window.py:12 steady/window.py:15
msgid "Create Task"
msgstr "Создать задачу"

#: steady/dialogs.py:78
msgid "Task Information"
msgstr "Сведения о задаче"

#: steady/dialogs.py:79
msgid "Task Title · Required"
msgstr "Название · Обязательно"

#: steady/dialogs.py:83
msgid "Task Description · Optional"
msgstr "Описание · Необязательно"

#: steady/dialogs.py:84
msgid "Task description, optional"
msgstr "Описание задачи, необязательно"

#: steady/dialogs.py:88 steady/window.py:13
msgid "Deadline"
msgstr "Срок"

#: steady/dialogs.py:88
msgid "Tasks can be created and worked on without a deadline."
msgstr "Задачи можно создавать и выполнять без указания срока."

#: steady/dialogs.py:89
msgid "Set a Deadline"
msgstr "Установить срок"

#: steady/dialogs.py:89
msgid "Optional; tasks without a deadline have no countdown"
msgstr "Необязательно; без срока обратный отсчёт не отображается"

#: steady/dialogs.py:94
msgid "Date · YYYY-MM-DD"
msgstr "Дата · ГГГГ-ММ-ДД"

#: steady/dialogs.py:97
msgid "Choose a date"
msgstr "Выбрать дату"

#: steady/dialogs.py:105
msgid "Time"
msgstr "Время"

#: steady/dialogs.py:112
msgid "Deadline: hour"
msgstr "Срок: часы"

#: steady/dialogs.py:113
msgid "Deadline: minute"
msgstr "Срок: минуты"

#: steady/dialogs.py:165
msgid "Local time, defaulting to 23:59. You can change or remove the deadline at any time."
msgstr "Местное время, по умолчанию 23:59. Срок можно изменить или убрать в любое время."

#: steady/dialogs.py:167
msgid "Example date: 2026-09-29"
msgstr "Пример даты: 2026-09-29"

#: steady/dialogs.py:216 steady/window.py:394 steady/window.ui:78
msgid "Close Task"
msgstr "Закрыть задачу"

#: steady/dialogs.py:216
msgid "Reopen Task"
msgstr "Открыть задачу снова"

#: steady/dialogs.py:216
msgid "Confirm Closure"
msgstr "Подтвердить закрытие"

#: steady/dialogs.py:216 steady/window.py:12 steady/window.py:394
msgid "Reopen"
msgstr "Открыть снова"

#: steady/dialogs.py:220
msgid "The task will leave the open list. All history will be kept."
msgstr "Задача исчезнет из списка открытых. Вся история сохранится."

#: steady/dialogs.py:220
msgid "The task will return to the open list. Previous closure records will be kept."
msgstr "Задача вернётся в список открытых. Предыдущие записи о закрытии сохранятся."

#: steady/dialogs.py:222
#, python-brace-format
msgid "Unfinished Todo items: {pending_todos}. You can still close this task; these items will not be checked automatically."
msgstr "Незавершённые пункты Todo: {pending_todos}. Задачу всё равно можно закрыть; эти пункты не будут отмечены автоматически."

#: steady/dialogs.py:223
msgid "Closure Note · Optional"
msgstr "Примечание к закрытию · Необязательно"

#: steady/dialogs.py:223
msgid "Reopening Note · Optional"
msgstr "Примечание к открытию · Необязательно"

#: steady/dialogs.py:224 steady/storage.py:220
msgid "Closure note"
msgstr "Примечание к закрытию"

#: steady/dialogs.py:224 steady/storage.py:229
msgid "Reopening note"
msgstr "Примечание к повторному открытию"

#: steady/i18n.py:50 steady/i18n.py:54
msgid "Invalid language setting"
msgstr "Недопустимая настройка языка"

#: steady/i18n.py:59
#, python-brace-format
